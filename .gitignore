# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
ENV/
env/

# Environment Variables & Local Config
.env
.env.local
*.local

# Database & Backups (permite o banco oficial e o backup em nuvem no GitHub)
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
database/tts_cache/
backups/*
!backups/a5_kanban_nuvem_latest.db
!backups/a5_kanban_nuvem_latest.json
scratch/

# User Uploads (mantém a pasta mas ignora arquivos de upload)
static/uploads/*
!static/uploads/.gitkeep

# PDFs de Esteira e Rotas Externas
entrada_pdfs/*
!entrada_pdfs/.gitkeep
arquivados_pdfs/*
!arquivados_pdfs/.gitkeep
entrada_chamados_externos/*
!entrada_chamados_externos/.gitkeep
arquivados_chamados_externos/*
!arquivados_chamados_externos/.gitkeep
rotas_imagens/*
!rotas_imagens/.gitkeep

# Logs & Temporary Files
*.log
*.tmp
*.bak
temp/

